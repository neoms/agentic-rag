# 阿里云百炼平台 API Key（必填）
DASHSCOPE_API_KEY=sk-your-api-key-here

# LLM 对话模型（必填，模型名只在 .env 中配置，代码不写死）
LLM_MODEL=qwen-plus
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0

# 快速模式（轻量任务）与强模型（最终生成）分别配置（必填）
LLM_MODEL_FAST=qwen-turbo
LLM_MODEL_STRONG=qwen-max

# Embedding 模型（必填）
EMBEDDING_MODEL=text-embedding-v4

# 重排序模型（RERANK_ENABLED=true 时必填）
RERANK_MODEL=gte-rerank-v2
RERANK_ENABLED=true
RERANK_TOP_K=5

# 百炼 OpenAI 兼容 API 地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ChromaDB 本地持久化路径（相对于项目根目录）
CHROMA_PERSIST_DIR=data/chroma

# 文档分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# 检索配置
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.5

# 对话记忆配置
MEMORY_WINDOW_SIZE=5

# 文件上传配置
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,md,txt

# 服务端口
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_FILE=log/app.log        # 滚动日志文件（10MB × 5）

# CORS 允许来源（逗号分隔多个来源；生产环境改为实际前端地址）
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 数据保留策略（防无界增长）
SESSION_MESSAGE_CAP=500      # 单会话最多保留消息条数（内存 + 库）
TASK_HISTORY_KEEP=100        # 上传任务保留条数
TASK_HISTORY_TTL_DAYS=7      # 已完成/失败任务保留天数

# ============ 评估与可观测性（Langfuse / 评测） ============
# Langfuse Cloud 追踪与评估平台（公钥/私钥成对配置；不配则全链路优雅降级）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM-as-judge 评判模型（独立强评判模型；留空回退 LLM_MODEL_STRONG）
EVAL_JUDGE_MODEL=
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
# judge 额外请求体参数（JSON；思考模型与 RAGAS n=3 冲突时填 {"enable_thinking": false}）
EVAL_JUDGE_EXTRA_BODY=
# 流式生成额外请求体参数（JSON；思考模型在长 prompt 下耗尽 token 预算导致空答案时，填 {"enable_thinking": false}）
GENERATION_EXTRA_BODY=

# 离线评估发布门禁阈值（JSON：{"faithfulness": 0.85, "context_recall": 0.70}）
EVAL_GATE_THRESHOLDS={}
# 在线评估采样比例（0 < rate <= 1）
EVAL_SAMPLE_RATE=0.1
# 压测/评估 stub 模式（不调用真实 LLM，仅验证流水线机制）
EVAL_STUB_LLM=false

# LLM 成本估算单价（元/百万 token；0 表示不计成本指标）
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0

# 文档索引后台队列
INDEX_WORKERS=2              # 后台索引并发 worker 数
INDEX_QUEUE_MAX=20           # 排队任务上限（超出拒绝上传）

# 多级缓存（精准 + 语义）
CACHE_ENABLED=true
CACHE_EXACT_ENABLED=true
CACHE_SEMANTIC_ENABLED=true
CACHE_SEMANTIC_THRESHOLD=0.92
CACHE_MAX_ENTRIES=5000
CACHE_TTL_SECONDS=0           # 0 = 不过期（仅按 LRU 淘汰）
CACHE_CITATION_MAX_CHARS=500  # 缓存引文段落最大长度
