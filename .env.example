# 阿里云百炼平台 API Key（必填）
DASHSCOPE_API_KEY=sk-your-api-key-here

# LLM 对话模型（可选，默认 qwen-plus）
LLM_MODEL=qwen-plus
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0

# LLM 模型备选：qwen-turbo / qwen-plus / qwen-max / qwen-long
# 快速模式用 qwen-turbo，生成模式用 qwen-max
LLM_MODEL_FAST=qwen-turbo
LLM_MODEL_STRONG=qwen-max

# Embedding 模型
EMBEDDING_MODEL=text-embedding-v4

# 百炼 OpenAI 兼容 API 地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ChromaDB 本地持久化路径（相对于项目根目录）
CHROMA_PERSIST_DIR=data/chroma

# 文档分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# 检索配置
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.5

# 对话记忆配置
MEMORY_WINDOW_SIZE=5

# 文件上传配置
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,md,txt

# 服务端口
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS 允许来源（逗号分隔多个来源；生产环境改为实际前端地址）
CORS_ALLOWED_ORIGINS=http://localhost:3000
